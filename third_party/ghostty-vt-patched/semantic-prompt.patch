+// steg patch (TASK-1.79): wires `GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT`,
+// following `cb_pwd_changed`'s own shape above.
+unsafe extern "C" fn cb_semantic_prompt(
+    _t: ffi::Terminal,
+    ud: *mut c_void,
+    event: *const ffi::TerminalSemanticPrompt,
+) {
+    let shared = unsafe { shared_from_userdata(ud) };
+    // SAFETY: libghostty guarantees a valid, non-null event for the
+    // callback's duration - the same contract `cb_clipboard_write`'s
+    // `write` parameter already relies on, stated on the sys crate's own
+    // callback-type doc comment.
+    let event = unsafe { &*event };
+    let kind = match event.kind {
+        ffi::SemanticPromptKind::GHOSTTY_SEMANTIC_PROMPT_PROMPT_START => {
+            SemanticPromptKind::PromptStart
+        }
+        ffi::SemanticPromptKind::GHOSTTY_SEMANTIC_PROMPT_INPUT_START => {
+            SemanticPromptKind::InputStart
+        }
+        ffi::SemanticPromptKind::GHOSTTY_SEMANTIC_PROMPT_OUTPUT_START => {
+            SemanticPromptKind::OutputStart
+        }
+        ffi::SemanticPromptKind::GHOSTTY_SEMANTIC_PROMPT_COMMAND_END => {
+            SemanticPromptKind::CommandEnd
+        }
+        _ => return, // GHOSTTY_SEMANTIC_PROMPT_INVALID, or a future value.
+    };
+    shared.events.push(Event::SemanticPrompt(SemanticPromptEvent {
+        kind,
+        has_exit_code: event.has_exit_code,
+        exit_code: event.exit_code,
+    }));
+}
