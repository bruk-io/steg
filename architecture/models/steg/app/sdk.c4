// Component: sdk, built into the app as well as the server and the CLI
// (doc-16, Level 3). One of three identical declarations — see
// models/steg/server/sdk.c4 for the others and the reasoning. Keep the
// title and description word for word the same in all three.
model {
  extend steg.app {
    sdk = component 'sdk' {
      #shared
      technology 'Rust library'
      description 'The public interface: the API description, the shapes that cross the API, and the protocol logic (R101). No I/O of its own (R102); a consumer supplies the transport. Built into the server, the CLI and the app alike — it belongs to none of them more than another (doc-16).'
    }
  }
}
