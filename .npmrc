# Resolve `npx likec4@<pinned version>` (justfile's check-architecture, likec4_mcp.py,
# .mcp.json) from npm's own cache without a live registry round trip when that version
# is already cached (TASK-1.97). npx makes that round trip on every invocation
# regardless of a warm package cache, and its own retry/backoff ladder is what turned a
# congested or unreachable registry into a 30s+ CI timeout (confirmed: a warm cache
# with the registry unreachable still took 70s without this setting, 0.4s with it).
# Safe as a blanket default for this whole repository (grepped for every npm/npx usage
# first - these three are the only ones): a cold cache, such as a first run or a bumped
# version, still falls through to the real network exactly as before.
prefer-offline=true
