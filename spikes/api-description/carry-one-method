#!/usr/bin/env bash
# Carry one method of steg's API end to end, in one command: TASK-1.3's acceptance
# criterion. `pane.split` is defined once in src/api.rs, and this script shows it served,
# self-described, called from both generated CLIs, called from Python, and documented.
#
# Run it from the repository root (which is where `asdlc record-check --in` puts you):
#
#     spikes/api-description/carry-one-method
#
# Everything it prints is evidence for the spike's document. It fails on the first step
# that does not do what it says.

set -euo pipefail

crate="spikes/api-description"
manifest="$crate/Cargo.toml"

if [ ! -f "$manifest" ]; then
    echo "run this from the repository root: $manifest is not there" >&2
    exit 2
fi

step() { printf '\n=== %s\n' "$1"; }

work="$(mktemp -d)"
socket="$work/steg.sock"
server_pid=""

cleanup() {
    if [ -n "$server_pid" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$work"
}
trap cleanup EXIT

step "build, release, because the measurements are taken on these binaries"
cargo build --release --quiet --manifest-path "$manifest"
bin="$crate/target/release"
rustc --version

step "the one definition: src/api.rs, and nothing else names a method or a flag"
grep -c 'fn pane_split' "$crate/src/api.rs" >/dev/null
echo "pane.split is defined in $crate/src/api.rs"
echo "consumers, each reading that one value:"
echo "  server    $crate/src/server.rs      dispatches and validates against it"
echo "  CLI       $crate/src/cli_build.rs   generates the command tree from it"
echo "  docs      $crate/src/docs.rs        renders the reference from it"
echo "  plugins   $crate/client.py          reads it as JSON over the socket"

step "start the server, and wait on the line it prints when the socket is bound"
mkfifo "$work/said"
"$bin/spike_server" "$socket" >"$work/said" &
server_pid=$!
head -n 1 "$work/said"

step "self-description: the payload a client gets when it asks the server (R37)"
STEG_SERVER="$socket" "$bin/spike_docs" --from-server --json

step "called through candidate A's generated command (the description is compiled in)"
STEG_SERVER="$socket" "$bin/spike_cli_a" pane split logs --direction right --label notes -- htop -d 5

step "called through candidate B's generated command (the description came from the server)"
STEG_SERVER="$socket" "$bin/spike_cli_b" pane split logs --direction left

step "called from Python, knowing only the description (R42, R75)"
uv run --quiet "$crate/client.py" "$socket"

step "the panes that now exist, printed in the fields the description declares"
STEG_SERVER="$socket" "$bin/spike_cli_a" pane list

step "an ambiguous target: R10 says never a guess, doc-2 says exit status 3"
status=0
STEG_SERVER="$socket" "$bin/spike_cli_a" pane split 0011 --direction right || status=$?
echo "exit status $status"
[ "$status" -eq 3 ] || { echo "expected status 3" >&2; exit 1; }

step "the reference docs, generated from the same description (R62)"
"$bin/spike_docs" | head -40

step "--help with no server running: doc-2 section 5 says it contacts no server"
dead="$work/nothing-here.sock"
status=0
STEG_SERVER="$dead" "$bin/spike_cli_a" pane split --help || status=$?
echo "candidate A: exit status $status"
[ "$status" -eq 0 ] || { echo "candidate A must answer --help with no server" >&2; exit 1; }

status=0
STEG_SERVER="$dead" "$bin/spike_cli_b" pane split --help >/dev/null 2>"$work/b.err" || status=$?
echo "candidate B: exit status $status, saying: $(cat "$work/b.err")"
[ "$status" -eq 4 ] || { echo "candidate B was expected to fail as unreachable" >&2; exit 1; }

step "measurements (see measure.py for the method)"
uv run --quiet "$crate/measure.py" "$bin" "$socket"

step "done"
echo "one method, defined once, served, self-described, called from two generated CLIs,"
echo "called from Python, and documented."
