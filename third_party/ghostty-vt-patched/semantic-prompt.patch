+/// One step of OSC 133 shell-integration reporting (steg patch, TASK-1.79).
+/// `command`/`error` (the C struct's other two fields) are deliberately
+/// left out: nothing reads them yet, and leaving them out means this
+/// patch never has to reason about their FFI string ownership.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SemanticPromptEvent {
+    /// Which step this is.
+    pub kind: SemanticPromptKind,
+    /// Whether the shell reported an exit code. Only ever `true` for
+    /// [`SemanticPromptKind::CommandEnd`] - and even then, not always: a
+    /// bare `D` mark, or one whose code the engine's own OSC parser could
+    /// not read, both report `false` here, verified by test.
+    pub has_exit_code: bool,
+    /// The command's exit code. Meaningless unless `has_exit_code` is
+    /// `true` - never read without checking that flag first.
+    pub exit_code: i32,
 }
 
+/// Which step of a command's lifecycle a [`SemanticPromptEvent`] reports
+/// (steg patch, TASK-1.79), mirroring `ghostty-vt-sys`'s own
+/// `SemanticPromptKind` one for one.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SemanticPromptKind {
+    /// OSC 133 `A`: a shell prompt is starting.
+    PromptStart,
+    /// OSC 133 `B`: the person's input is starting.
+    InputStart,
+    /// OSC 133 `C`: the command started producing output.
+    OutputStart,
+    /// OSC 133 `D`: the command ended.
+    CommandEnd,
+}
